import { Theme, BookData, SectionData, SourceData } from "widgets/theme.slint";
import { Section } from "widgets/section.slint";

component SourceTab inherits Rectangle {
    in property <bool> dark-mode: true;
    in property <bool> selected: false;
    in property <string> label;

    callback clicked();

    width: 104px;
    height: 34px;
    border-radius: 17px;
    background: selected ? Theme.accent : (dark-mode ? Theme.card-dark : Theme.card-light);

    TouchArea {
        clicked => { root.clicked(); }

        Text {
            text: label;
            font-size: 12px;
            font-weight: 600;
            color: selected ? white : (dark-mode ? Theme.text-dark : Theme.text-light);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component DiscoverView inherits Rectangle {
    in property <[SectionData]> sections;
    in property <[SourceData]> sources;
    in property <string> selected-source-id;
    in property <bool> is-loading;
    in property <bool> dark-mode: true;

    callback refresh();
    callback select-source(string);
    callback open-book(string, string);

    background: dark-mode ? Theme.bg-dark : Theme.bg-light;

    VerticalLayout {
        padding-top: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;

            Text {
                text: "Discover";
                font-size: 20px;
                font-weight: 700;
                color: dark-mode ? Theme.text-dark : Theme.text-light;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 70px;
                height: 36px;
                border-radius: 4px;
                background: dark-mode ? Theme.card-dark : Theme.card-light;

                TouchArea {
                    enabled: !is-loading;
                    clicked => { root.refresh(); }

                    Text {
                        text: is-loading ? "⏳" : "↻";
                        font-size: 16px;
                        color: dark-mode ? Theme.text-dark : Theme.text-light;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if sources.length > 0 : Flickable {
            height: 42px;
            viewport-width: sources.length * 112px;

            HorizontalLayout {
                padding-left: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                for source in sources : SourceTab {
                    dark-mode: root.dark-mode;
                    selected: source.id == selected-source-id;
                    label: source.name;
                    clicked => { root.select-source(source.id); }
                }
            }
        }

        if is-loading && sections.length == 0 : Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "⏳";
                    font-size: 32px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Loading discover...";
                    font-size: 14px;
                    color: Theme.text-muted-dark;
                    horizontal-alignment: center;
                }
            }
        }

        // Sections list
        if sections.length > 0 : Flickable {
            vertical-stretch: 1;
            viewport-height: sections.length * 230px;

            VerticalLayout {
                spacing: Theme.spacing-md;

                for section in sections : Section {
                    title: section.title;
                    books: section.books;
                    dark-mode: root.dark-mode;
                    book-clicked(id, sourceId) => { root.open-book(id, sourceId); }
                }
            }
        }

        // Empty state (no sections and not loading)
        if !is-loading && sections.length == 0 : Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "🔍";
                    font-size: 48px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "No content found";
                    font-size: 16px;
                    font-weight: 600;
                    color: dark-mode ? Theme.text-dark : Theme.text-light;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Tap refresh to try again";
                    font-size: 12px;
                    color: Theme.text-muted-dark;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
